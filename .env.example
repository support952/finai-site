# Copy to .env.local (never commit it). Names only — no values here.

# Public site URL, no trailing slash (e.g. https://finaisolutions.co)
NEXT_PUBLIC_SITE_URL=

# Supabase (Project Settings → API). Anon/publishable key is public; service role/secret key is SERVER ONLY.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Authorize.Net — "sandbox" (default) or "production".
# production additionally requires AUTHNET_ALLOW_PRODUCTION=true.
AUTHNET_ENV=sandbox
AUTHNET_ALLOW_PRODUCTION=
AUTHNET_API_LOGIN_ID=
AUTHNET_TRANSACTION_KEY=
# Account → Settings → API Credentials & Keys → Signature Key (used to verify X-ANET-Signature)
AUTHNET_SIGNATURE_KEY=

# HMAC secret for affiliate payment links (>= 32 random chars, e.g. `openssl rand -hex 32`).
# Rotating it invalidates every existing affiliate link.
LINK_SIGNING_SECRET=

# Mailgun
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
# https://api.mailgun.net (US) or https://api.eu.mailgun.net (EU)
MAILGUN_API_BASE=https://api.mailgun.net
# e.g. "FINAI SOLUTIONS <support@finaisolutions.co>"
MAIL_FROM=
